{
  "name": "bureau-of-questionable-knowledge",
  "private": true,
  "version": "1.0.0-rc.1",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12 <25",
    "pnpm": "11.19.0"
  },
  "description": "A local shared-screen British party game of knowledge, judgement, risk and administrative chaos for one to four players.",
  "author": "Private project — legal rights holder must be named before commercial distribution",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "development:report": "tsx scripts/development-report.ts",
    "editorial:audit": "tsx scripts/check-editorial-certification.ts",
    "editorial:certify": "tsx scripts/check-editorial-certification.ts --require-approved",
    "editorial:import": "tsx scripts/import-editorial-review.ts",
    "playtest:verify": "tsx scripts/verify-playtest-evidence.ts",
    "balance:beta": "tsx scripts/analyse-beta-balance.ts",
    "presentation:audit": "tsx scripts/check-presentation-assets.ts",
    "check": "pnpm run release:records && pnpm run editorial:audit && pnpm run balance:beta && pnpm run presentation:audit && pnpm run typecheck && pnpm run test && pnpm run desktop:test && pnpm run build:web && pnpm run performance:certify && pnpm run e2e && pnpm run stage9:audit",
    "build:web": "vite build",
    "release:records": "tsx scripts/export-question-sources.ts && tsx scripts/export-media-rights.ts && tsx scripts/export-editorial-review.ts",
    "desktop:test": "node --test electron/*.test.cjs",
    "e2e": "playwright test",
    "e2e:update": "playwright test e2e/visual.spec.ts --update-snapshots",
    "desktop:dev": "pnpm run build && electron .",
    "desktop:package": "node scripts/build-windows-release.cjs",
    "desktop:installer": "node scripts/build-windows-release.cjs --installer",
    "update:channel": "node scripts/stage-update-channel.cjs",
    "windows:acceptance": "node scripts/verify-windows-acceptance.cjs",
    "performance:certify": "tsx scripts/measure-release-performance.ts",
    "stage9:audit": "tsx scripts/check-stage9-certification.ts",
    "stage9:certify": "tsx scripts/check-stage9-certification.ts --require-human && pnpm run windows:acceptance",
    "storefront:capture": "tsx scripts/capture-storefront.ts",
    "storefront:verify": "tsx scripts/verify-storefront-assets.ts",
    "stage10:audit": "pnpm run storefront:verify && tsx scripts/check-stage10-readiness.ts",
    "desktop:dist": "pnpm run release:windows",
    "release:verify": "node scripts/verify-windows-release.cjs",
    "release:windows": "pnpm run check && pnpm run desktop:package && pnpm run release:verify",
    "release:installer": "pnpm run check && pnpm run desktop:installer && node scripts/verify-windows-release.cjs --require-installer",
    "signing:check": "node scripts/check-signing-environment.cjs",
    "commercial:check": "tsx scripts/check-commercial-rights.ts",
    "security:audit": "pnpm audit --prod && pnpm audit",
    "rc:audit": "tsx scripts/check-release-candidate.ts",
    "rc:verify": "pnpm run security:audit && pnpm run check && tsx scripts/check-release-candidate.ts --automated-passed && pnpm run desktop:installer && node scripts/verify-windows-release.cjs --require-installer && tsx scripts/check-release-candidate.ts --automated-passed",
    "rc:go": "pnpm run storefront:verify && pnpm run stage9:certify && pnpm run commercial:check && pnpm run signing:check && pnpm run rc:verify && tsx scripts/check-release-candidate.ts --automated-passed --require-go && tsx scripts/check-stage10-readiness.ts --require-go",
    "commercial:dist": "pnpm run security:audit && pnpm run commercial:check && pnpm run editorial:certify && pnpm run signing:check && pnpm run windows:acceptance && pnpm run check && node scripts/build-windows-release.cjs --installer --commercial && node scripts/verify-windows-release.cjs --require-installer --require-signed && pnpm run update:channel"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@playwright/test": "1.55.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "canvas-confetti": "^1.9.4",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "uk.co.questionableknowledge.bureau",
    "productName": "The Bureau of Questionable Knowledge",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "README.md",
      "HOST-QUICK-REFERENCE.md",
      "LICENSES.md",
      "THIRD-PARTY-NOTICES.md",
      "QUESTION-SOURCES.json",
      "QUESTION-REVIEW-PROTOCOL.md",
      "EDITORIAL-REVIEW-QUEUE.csv",
      "EDITORIAL-CERTIFICATION.json",
      "EDITORIAL-POLICY.md",
      "E2E-REGRESSION.md",
      "PACING-AND-BALANCE.md",
      "BALANCE-PLAYTEST-PROTOCOL.md",
      "ASSET-RIGHTS.json",
      "COMMERCIAL-IDENTITY.json",
      "GENERATED-ART-PROVENANCE.json",
      "ARTWORK-PROVENANCE.md",
      "LEGAL-HANDOFF.md",
      "ARTWORK-QUALITY-REVIEW.json",
      "AUDIO-QUALITY-REVIEW.json",
      "PERFORMANCE-BUDGETS.json",
      "PERFORMANCE-CERTIFICATION.json",
      "STAGE-9-CERTIFICATION.json",
      "STAGE-9-CERTIFICATION.md",
      "STOREFRONT-CAPTURES.json",
      "STAGE-10-READINESS.json",
      "STAGE-10-RELEASE-HANDOFF.md",
      "PRESENTATION-ASSET-AUDIT.md",
      "UPDATE-CHANNEL.json",
      "WINDOWS-DISTRIBUTION.md",
      "WINDOWS-ACCEPTANCE.csv",
      "TRADEMARK-CLEARANCE.md",
      "EULA.md",
      "PRIVACY.md",
      "ACCESSIBILITY.md",
      "SUPPORT.md",
      "RELEASE-CHECKLIST.md",
      "RELEASE-CANDIDATE-STATUS.json",
      "RELEASE-NOTES-1.0.0-rc.1.md",
      "CLOSED-BETA-GUIDE.md",
      "PLAYTEST-CERTIFICATION.json",
      "PLAYTEST-FINDINGS.md",
      "BETA-BALANCE-REPORT.json",
      "STOREFRONT-COPY.md",
      "STOREFRONT-ASSET-BRIEF.md",
      "KNOWN-ISSUES.json",
      "KNOWN-ISSUES.md",
      "FIRST-MONTH-SUPPORT-PLAN.md",
      "ACCESSIBILITY-ACCEPTANCE.csv",
      "VISUAL-PLAYTEST-PROTOCOL.md",
      "BLIND-PLAYTEST-PROTOCOL.md"
    ],
    "asarUnpack": [],
    "npmRebuild": false,
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Bureau-of-Questionable-Knowledge-${version}-portable-${arch}.${ext}",
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "artifactName": "Bureau-of-Questionable-Knowledge-${version}-setup-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "${env.BUREAU_UPDATE_URL}",
        "channel": "stable"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    }
  }
}
